{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "Admin"
    },
    "blog": {
      "root": "Blog",
      "framework": "vite"
    },
    "site": {
      "root": "Site",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": { "service": "admin" }
    },
    {
      "source": "/admin/(.*)",
      "destination": { "service": "admin" }
    },
    {
      "source": "/blog",
      "destination": { "service": "blog" }
    },
    {
      "source": "/blog/(.*)",
      "destination": { "service": "blog" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "site" }
    }
  ]
}
